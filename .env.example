# ══════════════════════════════════════════════════════════════════════════════
# UGIE — Universal GitHub Intelligence Engine
# Environment Configuration
# Copy to .env and fill in all required values before starting.
# ══════════════════════════════════════════════════════════════════════════════

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Supabase (required) ───────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── GitHub OAuth App (required) ───────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── GitHub Webhook Secret ─────────────────────────────────────────────────────
# Set this in GitHub repo → Settings → Webhooks → Secret
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ── Token Encryption Key (required) ──────────────────────────────────────────
# Fernet symmetric encryption key for storing GitHub tokens
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-key-here

# ── JWT Session Signing ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# ── OAuth Redirect URI ────────────────────────────────────────────────────────
# Must match GitHub OAuth App callback URL exactly
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Backfill Configuration ────────────────────────────────────────────────────
BACKFILL_DEPTH=200

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list not supported — edit app/config.py CORS_ORIGINS for multiple
